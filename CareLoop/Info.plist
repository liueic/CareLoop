<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHealthShareUsageDescription</key>
	<string>读取您授权的心率、睡眠、步数、血压与血糖等健康数据，用于建立个人基线、生成可解释的异常提示，以及在手帐照片上叠加拍摄时刻的健康上下文。本应用不提供疾病诊断。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄带健康水印的手帐照片，帮助您低成本记录当天状态。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于语音速记手帐，并在设备端转成文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>在设备端将语音记录转成文字，便于您回顾手帐。转写默认不上传服务器。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>允许从相册选择照片写入手帐时间线。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>允许将带水印的手帐照片保存到相册。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在您询问附近美食时获取当前位置、搜索周边餐厅，以及可选择在水印照片中显示拍摄地点。位置信息只用于本地搜索，不会与健康数据一起发送。</string>
	<key>AmapDefaultKey</key>
	<string>$(AMAP_MCP_KEY)</string>
	<key>UIBackgroundModes</key>
	<array/>
</dict>
</plist>
