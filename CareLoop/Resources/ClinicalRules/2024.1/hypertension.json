{
  "ruleset": {
    "id": "hypertension",
    "version": "2024.1.0",
    "disease_category": "hypertension",
    "standard_profile": "CN-2023",
    "status": "active",
    "effective_date": "2024-06-01",
    "author": "clinical-content-team",
    "reviewer": "medical-advisory-board",
    "sources": [
      {
        "source_id": "CHTG-2023",
        "org_cn": "中国高血压防治指南修订委员会",
        "org_en": "Chinese Hypertension Prevention and Treatment Guideline Revision Committee",
        "title": "中国高血压防治指南（2023年修订版）",
        "year": 2023,
        "publisher": "中华高血压杂志"
      }
    ],
    "rules": [
      {
        "id": "HTN-SP-001",
        "name": {
          "cn": "家庭血压高血压分级（HBPM标准）",
          "en": "Home Blood Pressure Hypertension Grading (HBPM Standard)"
        },
        "type": "single_point",
        "priority": 100,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp",
            "dbp"
          ],
          "context": [
            "measured_at",
            "posture"
          ],
          "unit_requirements": {
            "sbp": "mmHg",
            "dbp": "mmHg"
          }
        },
        "conditions": {
          "any": [
            {
              "all": {
                "sbp": {
                  "gte": 180
                },
                "dbp": {
                  "gte": 110
                }
              },
              "output_risk": "urgent",
              "tag": "hypertensive_crisis"
            },
            {
              "all": {
                "sbp": {
                  "gte": 160,
                  "lt": 180
                }
              },
              "output_risk": "high",
              "tag": "grade2_hypertension"
            },
            {
              "all": {
                "sbp": {
                  "gte": 135,
                  "lt": 160
                }
              },
              "output_risk": "medium",
              "tag": "grade1_hypertension"
            },
            {
              "all": {
                "sbp": {
                  "gte": 120,
                  "lt": 135
                }
              },
              "output_risk": "low_elevated",
              "tag": "high_normal"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第3章 高血压诊断与评估, 表3-2 家庭血压标准",
            "quote": "家庭血压≥135/85 mmHg可确诊高血压"
          }
        ],
        "confidence": "high",
        "advice_ids": [
          "AD-HTN-101",
          "AD-HTN-102"
        ]
      },
      {
        "id": "HTN-SP-002",
        "name": {
          "cn": "诊室血压高血压分级",
          "en": "Office Blood Pressure Hypertension Grading"
        },
        "type": "single_point",
        "priority": 90,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp",
            "dbp"
          ],
          "context": [
            "measured_at",
            "setting"
          ],
          "unit_requirements": {
            "sbp": "mmHg",
            "dbp": "mmHg"
          }
        },
        "conditions": {
          "any": [
            {
              "all": {
                "sbp": {
                  "gte": 180
                },
                "dbp": {
                  "gte": 110
                }
              },
              "output_risk": "urgent",
              "tag": "grade3_hypertension"
            },
            {
              "all": {
                "sbp": {
                  "gte": 160,
                  "lt": 180
                }
              },
              "output_risk": "high",
              "tag": "grade2_hypertension"
            },
            {
              "all": {
                "sbp": {
                  "gte": 140,
                  "lt": 160
                }
              },
              "output_risk": "medium",
              "tag": "grade1_hypertension"
            },
            {
              "all": {
                "sbp": {
                  "gte": 120,
                  "lt": 140
                }
              },
              "output_risk": "low_elevated",
              "tag": "high_normal"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第3章, 表3-1 诊室血压分级标准",
            "quote": "诊室血压收缩压≥140mmHg和/或舒张压≥90mmHg可确诊高血压"
          }
        ],
        "confidence": "high",
        "advice_ids": [
          "AD-HTN-101",
          "AD-HTN-102"
        ]
      },
      {
        "id": "HTN-SP-003",
        "name": {
          "cn": "单纯收缩期高血压",
          "en": "Isolated Systolic Hypertension"
        },
        "type": "single_point",
        "priority": 85,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp",
            "dbp"
          ],
          "unit_requirements": {
            "sbp": "mmHg",
            "dbp": "mmHg"
          }
        },
        "conditions": {
          "any": [
            {
              "all": {
                "sbp": {
                  "gte": 140
                },
                "dbp": {
                  "lt": 90
                }
              },
              "output_risk": "medium",
              "tag": "isolated_systolic"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第3章 高血压分类",
            "quote": "单纯收缩期高血压：收缩压≥140mmHg，舒张压<90mmHg"
          }
        ],
        "confidence": "high",
        "advice_ids": [
          "AD-HTN-101",
          "AD-HTN-102"
        ]
      },
      {
        "id": "HTN-SP-004",
        "name": {
          "cn": "低血压警告",
          "en": "Hypotension Warning"
        },
        "type": "single_point",
        "priority": 95,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp",
            "dbp"
          ],
          "unit_requirements": {
            "sbp": "mmHg",
            "dbp": "mmHg"
          }
        },
        "conditions": {
          "any": [
            {
              "all": {
                "sbp": {
                  "lt": 90
                },
                "dbp": {
                  "lt": 60
                }
              },
              "output_risk": "medium",
              "tag": "hypotension"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第3章 血压异常",
            "quote": "血压<90/60mmHg为低血压"
          }
        ],
        "confidence": "high",
        "advice_ids": [
          "AD-HTN-103"
        ]
      },
      {
        "id": "HTN-TR-001",
        "name": {
          "cn": "7天家庭血压均值评估",
          "en": "7-Day Home Blood Pressure Mean Assessment"
        },
        "type": "trend",
        "priority": 80,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp"
          ],
          "window": {
            "days": 7,
            "min_samples": 3,
            "min_samples_per_day": 1
          }
        },
        "conditions": {
          "any": [
            {
              "aggregate": {
                "mean": {
                  "gte": 135
                }
              },
              "output_risk": "medium",
              "tag": "sustained_hypertension"
            },
            {
              "aggregate": {
                "mean": {
                  "gte": 130,
                  "lt": 135
                }
              },
              "output_risk": "low_elevated",
              "tag": "high_normal_trend"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第5章 高血压的治疗与管理, 5.2 家庭血压监测",
            "quote": "家庭血压均值≥135/85mmHg为高血压"
          }
        ],
        "confidence": "high",
        "advice_ids": [
          "AD-HTN-101",
          "AD-HTN-102"
        ]
      },
      {
        "id": "HTN-TR-002",
        "name": {
          "cn": "血压晨峰检测",
          "en": "Blood Pressure Morning Surge Detection"
        },
        "type": "trend",
        "priority": 75,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp"
          ],
          "window": {
            "days": 7,
            "min_samples": 5,
            "min_samples_per_day": 1
          }
        },
        "conditions": {
          "any": [
            {
              "aggregate": {
                "morning_surge": {
                  "gte": 20
                }
              },
              "output_risk": "medium",
              "tag": "morning_surge"
            },
            {
              "aggregate": {
                "morning_surge": {
                  "gte": 35
                }
              },
              "output_risk": "high",
              "tag": "excessive_morning_surge"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第4章 血压测量, 4.3 动态血压监测",
            "quote": "晨峰血压升高（≥20mmHg）是心血管事件的独立风险因子"
          }
        ],
        "confidence": "medium",
        "advice_ids": [
          "AD-HTN-102",
          "AD-HTN-103"
        ]
      },
      {
        "id": "HTN-TR-003",
        "name": {
          "cn": "血压上升趋势检测",
          "en": "Blood Pressure Rising Trend Detection"
        },
        "type": "trend",
        "priority": 70,
        "enabled": true,
        "inputs": {
          "required": [
            "sbp"
          ],
          "window": {
            "days": 14,
            "min_samples": 7,
            "min_samples_per_day": 1
          }
        },
        "conditions": {
          "any": [
            {
              "aggregate": {
                "slope_per_week": {
                  "gte": 5
                }
              },
              "output_risk": "medium",
              "tag": "rising_trend"
            },
            {
              "aggregate": {
                "slope_per_week": {
                  "gte": 10
                }
              },
              "output_risk": "high",
              "tag": "rapid_rising"
            }
          ],
          "default_risk": "normal"
        },
        "evidence": [
          {
            "source_id": "CHTG-2023",
            "section": "第5章 高血压的管理",
            "quote": "血压持续上升趋势提示需要加强管理"
          }
        ],
        "confidence": "medium",
        "advice_ids": [
          "AD-HTN-101",
          "AD-HTN-102"
        ]
      }
    ]
  }
}
